{
  "manifest_version": 3,
  "name": "Smart Shopping & Adidas Price Checker",
  "version": "1.1",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.adidas.co.il/*",
    "https://adidas.co.il/*",
    "https://www.adidas.com/*",
    "https://adidas.com/*",
    "https://www.terminalx.com/*",
    "https://terminalx.com/*",
    "https://www.nike.com/il/*",
    "https://nike.com/il/*",
    "https://*.super-pharm.co.il/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
 "content_scripts": [
    {
      "matches": [
        "https://www.adidas.co.il/*",
        "https://adidas.co.il/*",
        "https://www.adidas.com/*",
        "https://adidas.com/*",
        "https://www.terminalx.com/*",
        "https://terminalx.com/*",
        "https://www.nike.com/il/*",
        "https://nike.com/il/*",
        "https://*.super-pharm.co.il/*"
      ],
      "js": [ "userTracker.js" ]
    },
    {
      "matches": [
        "https://www.adidas.co.il/*",
        "https://adidas.co.il/*",
        "https://www.adidas.com/*",
        "https://adidas.com/*"
      ],
      "js": [ "content.js" ]
    }
  ]
}
